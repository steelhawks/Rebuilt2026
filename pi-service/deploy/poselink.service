# Steel Hawks PoseLink vision/pose service.
# Install: sudo cp poselink.service /etc/systemd/system/ && sudo systemctl daemon-reload
#          && sudo systemctl enable poselink
# Logs:    journalctl -u poselink -f
#
# Adjust User / paths if your Pi's deploy dir or login user differ. These MUST
# stay in sync with PI_USER / DEPLOY_DIR in deploy_pi.sh, or systemd will start a
# stale jar from the old directory (or crash-loop if it isn't there at all).

[Unit]
Description=Steel Hawks PoseLink vision/pose service
After=network-online.target photonvision.service
Wants=network-online.target

[Service]
Type=simple
User=photon
WorkingDirectory=/home/photon/poselink
# java.library.path covers both native sets: lib/ holds the WPILib arm64 .so
# files rsynced by deploy_pi.sh (ntcorejni, wpiHaljni, wpimathjni, ...), the
# deploy dir itself holds libposelink_gtsam.so built on the Pi. The WPILib libs
# are RPATH=$ORIGIN, so keeping them together in lib/ resolves their deps.
ExecStart=/usr/bin/java -XX:+UseSerialGC -Djava.library.path=/home/photon/poselink/lib:/home/photon/poselink -jar /home/photon/poselink/poselink.jar
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
